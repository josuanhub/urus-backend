/* BOXES */
.box-dark{background:#0b0b0b;border-radius:10px;padding:24px 28px;margin:20px 0;border-left:5px solid #c9a24d}
.box-dark-label{font-size:10px;color:#6b7280;text-transform:uppercase;letter-spacing:1.5px;margin-bottom:10px}
