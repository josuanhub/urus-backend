<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<title>URUS Dashboard</title>

<style>
/* =========================
   RESET + BASE
========================= */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, "Inter", sans-serif;
}

body {
  background: #0b0b0b;
  color: #fff;
  height: 100vh;
  overflow: hidden;
}

/* =========================
   LAYOUT
========================= */
.app {
  display: flex;
  height: 100vh;
}

.sidebar {
  width: 260px;
  background: #0f0f0f;
  border-right: 1px solid rgba(255,255,255,0.05);
  display: flex;
  flex-direction: column;
}

.logo {
  padding: 20px;
  font-weight: 700;
  font-size: 18px;
  color: #c9a24d;
}

.nav {
  display: flex;
  flex-direction: column;
}

.nav-item {
  padding: 14px 20px;
  cursor: pointer;
  color: #aaa;
  transition: 0.2s;
}

.nav-item:hover,
.nav-item.active {
  background: rgba(201,162,77,0.1);
  color: #fff;
}

.main {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* =========================
   HEADER
========================= */
.header {
  padding: 16px 20px;
  border-bottom: 1px solid rgba(255,255,255,0.05);
  display: flex;
  justify-content: space-between;
}

.metric {
  display: flex;
  flex-direction: column;
}

.metric span:first-child {
  font-size: 12px;
  color: #777;
}

.metric span:last-child {
  font-size: 18px;
  font-weight: 600;
  color: #c9a24d;
}

/* =========================
   CONTENT
========================= */
.content {
  flex: 1;
  display: flex;
  overflow: hidden;
}

/* =========================
   LEADS LIST
========================= */
.leads {
  width: 320px;
  border-right: 1px solid rgba(255,255,255,0.05);
  display: flex;
  flex-direction: column;
}

.search {
  padding: 10px;
}

.search input {
  width: 100%;
  padding: 10px;
  background: #111;
  border: none;
  color: #fff;
  border-radius: 6px;
}

.lead-list {
  flex: 1;
  overflow-y: auto;
}

.lead-item {
  padding: 14px;
  border-bottom: 1px solid rgba(255,255,255,0.05);
  cursor: pointer;
}

.lead-item.active {
  background: rgba(201,162,77,0.1);
}

.lead-name {
  font-weight: 600;
}

.lead-last {
  font-size: 12px;
  color: #777;
}

/* =========================
   CHAT
========================= */
.chat {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.messages {
  flex: 1;
  overflow-y: auto;
  padding: 20px;
}

.message {
  margin-bottom: 12px;
  max-width: 70%;
  padding: 10px 14px;
  border-radius: 14px;
  font-size: 14px;
}

.message.in {
  background: #1a1a1a;
}

.message.out {
  background: #c9a24d;
  color: #000;
  margin-left: auto;
}

.input-bar {
  padding: 10px;
  display: flex;
  border-top: 1px solid rgba(255,255,255,0.05);
}

.input-bar input {
  flex: 1;
  padding: 12px;
  background: #111;
  border: none;
  color: #fff;
  border-radius: 8px;
}

.input-bar button {
  margin-left: 10px;
  padding: 12px 16px;
  background: #c9a24d;
  border: none;
  border-radius: 8px;
  cursor: pointer;
}

/* =========================
   MOBILE
========================= */
@media (max-width: 768px) {
  .sidebar {
    display: none;
  }

  .leads {
    width: 100%;
  }

  .chat {
    display: none;
  }

  .chat.active {
    display: flex;
  }
}
</style>
</head>

<body>

<div class="app">

  <div class="sidebar">
    <div class="logo">URUS</div>
    <div class="nav">
      <div class="nav-item active">Dashboard</div>
      <div class="nav-item">Leads</div>
      <div class="nav-item">Pipeline</div>
      <div class="nav-item">Settings</div>
    </div>
  </div>

  <div class="main">

    <div class="header">
      <div class="metric">
        <span>Revenue estimado</span>
        <span id="revenue">$0</span>
      </div>
      <div class="metric">
        <span>Leads activos</span>
        <span id="leadsCount">0</span>
      </div>
      <div class="metric">
        <span>Conversion rate</span>
        <span id="conversion">0%</span>
      </div>
    </div>

    <div class="content">

      <!-- LEADS -->
      <div class="leads">
        <div class="search">
          <input id="searchInput" placeholder="Buscar lead..." />
        </div>
        <div class="lead-list" id="leadList"></div>
      </div>

      <!-- CHAT -->
      <div class="chat" id="chat">
        <div class="messages" id="messages"></div>

        <div class="input-bar">
          <input id="messageInput" placeholder="Escribe mensaje..." />
          <button onclick="sendMessage()">Enviar</button>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
/* =========================
   STATE
========================= */
const appState = {
  leads: [],
  selectedLead: null,
  messages: {}
};

/* =========================
   API
========================= */
async function fetchLeads() {
  const res = await fetch("/v1/wa/leads");
  const data = await res.json();
  appState.leads = data;
  renderLeads();
  updateMetrics();
}

async function fetchMessages(id) {
  const res = await fetch(`/v1/wa/leads/${id}/messages`);
  const data = await res.json();
  appState.messages[id] = data;
  renderMessages();
}

async function sendMessage() {
  const input = document.getElementById("messageInput");
  const text = input.value;
  if (!text) return;

  await fetch(`/v1/wa/leads/${appState.selectedLead.id}/send`, {
    method: "POST",
    headers: {"Content-Type":"application/json"},
    body: JSON.stringify({ message: text })
  });

  input.value = "";
  fetchMessages(appState.selectedLead.id);
}

/* =========================
   RENDER
========================= */
function renderLeads() {
  const list = document.getElementById("leadList");
  list.innerHTML = "";

  appState.leads.forEach(l => {
    const div = document.createElement("div");
    div.className = "lead-item";
    if (appState.selectedLead?.id === l.id) div.classList.add("active");

    div.innerHTML = `
      <div class="lead-name">${l.name || l.phone}</div>
      <div class="lead-last">${l.last_message || ""}</div>
    `;

    div.onclick = () => {
      appState.selectedLead = l;
      fetchMessages(l.id);
      renderLeads();
    };

    list.appendChild(div);
  });
}

function renderMessages() {
  const container = document.getElementById("messages");
  container.innerHTML = "";

  const msgs = appState.messages[appState.selectedLead.id] || [];

  msgs.forEach(m => {
    const div = document.createElement("div");
    div.className = "message " + (m.direction === "out" ? "out" : "in");
    div.innerText = m.text;
    container.appendChild(div);
  });

  container.scrollTop = container.scrollHeight;
}

/* =========================
   METRICS
========================= */
function updateMetrics() {
  document.getElementById("leadsCount").innerText = appState.leads.length;

  const revenue = appState.leads.reduce((sum, l) => sum + (l.value || 0), 0);
  document.getElementById("revenue").innerText = "$" + revenue;

  const closed = appState.leads.filter(l => l.status === "closed").length;
  const rate = appState.leads.length ? (closed / appState.leads.length * 100).toFixed(1) : 0;
  document.getElementById("conversion").innerText = rate + "%";
}

/* =========================
   INIT
========================= */
fetchLeads();
</script>

</body>
</html>
