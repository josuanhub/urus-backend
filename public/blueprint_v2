<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<title>URUS Dashboard</title>

<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:-apple-system,BlinkMacSystemFont,"Inter",sans-serif;}
body{background:#0b0b0b;color:#fff;height:100vh;overflow:hidden;}
.app{display:flex;height:100vh;}

/* SIDEBAR */
.sidebar{width:260px;background:#0f0f0f;border-right:1px solid rgba(255,255,255,0.05);display:flex;flex-direction:column;}
.logo{padding:20px;font-weight:700;font-size:18px;color:#c9a24d;}
.nav{display:flex;flex-direction:column;}
.nav-item{padding:14px 20px;cursor:pointer;color:#aaa;}
.nav-item.active,.nav-item:hover{background:rgba(201,162,77,0.1);color:#fff;}

/* MAIN */
.main{flex:1;display:flex;flex-direction:column;overflow:hidden;}
.header{padding:16px 20px;border-bottom:1px solid rgba(255,255,255,0.05);display:flex;gap:30px;}
.metric span:first-child{font-size:12px;color:#777;}
.metric span:last-child{font-size:18px;color:#c9a24d;font-weight:600;}

/* CONTENT */
.content{flex:1;display:flex;overflow:hidden;}

/* LEADS */
.leads{width:320px;border-right:1px solid rgba(255,255,255,0.05);display:flex;flex-direction:column;}
.search{padding:10px;}
.search input{width:100%;padding:10px;background:#111;border:none;color:#fff;border-radius:6px;}
.filters{display:flex;gap:6px;padding:10px;}
.filter{padding:6px 10px;background:#111;border-radius:6px;font-size:12px;cursor:pointer;}
.filter.active{background:#c9a24d;color:#000;}

.lead-list{flex:1;overflow-y:auto;}
.lead-item{padding:14px;border-bottom:1px solid rgba(255,255,255,0.05);cursor:pointer;position:relative;}
.lead-item.active{background:rgba(201,162,77,0.1);}
.badge{position:absolute;right:10px;top:16px;background:#c9a24d;color:#000;padding:2px 6px;border-radius:10px;font-size:10px;}
.lead-name{font-weight:600;}
.lead-last{font-size:12px;color:#777;}

/* CHAT */
.chat{flex:1;display:flex;flex-direction:column;}
.messages{flex:1;overflow-y:auto;padding:20px;}
.message{margin-bottom:12px;max-width:70%;padding:10px 14px;border-radius:14px;font-size:14px;}
.in{background:#1a1a1a;}
.out{background:#c9a24d;color:#000;margin-left:auto;}

.typing{font-size:12px;color:#888;margin-top:5px;}

.input-bar{padding:10px;display:flex;border-top:1px solid rgba(255,255,255,0.05);}
.input-bar input{flex:1;padding:12px;background:#111;border:none;color:#fff;border-radius:8px;}
.input-bar button{margin-left:10px;padding:12px 16px;background:#c9a24d;border:none;border-radius:8px;cursor:pointer;}

/* PIPELINE */
.pipeline{display:flex;gap:10px;padding:10px;border-bottom:1px solid rgba(255,255,255,0.05);}
.stage{flex:1;background:#111;padding:10px;border-radius:6px;font-size:12px;text-align:center;}
.stage span{display:block;margin-top:4px;color:#c9a24d;font-weight:600;}

/* CALENDAR */
.calendar{padding:10px;border-top:1px solid rgba(255,255,255,0.05);}
.followup{font-size:12px;margin-bottom:6px;color:#aaa;}

/* LOADING */
.loading{padding:20px;text-align:center;color:#777;}
.empty{padding:20px;text-align:center;color:#777;}

/* MOBILE */
@media(max-width:768px){
.sidebar{display:none;}
.leads{width:100%;}
.chat{display:none;}
.chat.active{display:flex;}
}
</style>
</head>

<body>

<div class="app">

<div class="sidebar">
<div class="logo">URUS</div>
<div class="nav">
<div class="nav-item active">Dashboard</div>
<div class="nav-item">Leads</div>
<div class="nav-item">Pipeline</div>
</div>
</div>

<div class="main">

<div class="header">
<div class="metric"><span>Revenue</span><span id="revenue">$0</span></div>
<div class="metric"><span>Leads</span><span id="leadsCount">0</span></div>
<div class="metric"><span>Conversion</span><span id="conversion">0%</span></div>
</div>

<div class="pipeline" id="pipeline"></div>

<div class="content">

<div class="leads">
<div class="search">
<input id="searchInput" placeholder="Buscar..." oninput="renderLeads()" />
</div>

<div class="filters">
<div class="filter active" onclick="setFilter('all')">Todos</div>
<div class="filter" onclick="setFilter('new')">Nuevo</div>
<div class="filter" onclick="setFilter('closed')">Cerrado</div>
</div>

<div class="lead-list" id="leadList"></div>
</div>

<div class="chat" id="chat">
<div class="messages" id="messages"></div>
<div class="typing" id="typing" style="display:none;">escribiendo...</div>

<div class="input-bar">
<input id="messageInput" placeholder="Escribe..." />
<button onclick="sendMessage()">Enviar</button>
</div>

<div class="calendar" id="calendar"></div>

</div>

</div>
</div>
</div>

<script>
const appState={
leads:[],
selectedLead:null,
messages:{},
filter:"all",
unread:{}
};

/* API */
async function fetchLeads(){
renderLoading();
const res=await fetch("/v1/wa/leads");
const data=await res.json();
appState.leads=data;
renderLeads();
updateMetrics();
renderPipeline();
}

async function fetchMessages(id){
document.getElementById("typing").style.display="block";

const res=await fetch(`/v1/wa/leads/${id}/messages`);
const data=await res.json();

appState.messages[id]=data;
appState.unread[id]=0;

renderMessages();
renderLeads();
renderCalendar();

setTimeout(()=>document.getElementById("typing").style.display="none",500);
}

/* SEND */
async function sendMessage(){
const input=document.getElementById("messageInput");
const text=input.value.trim();
if(!text)return;

await fetch(`/v1/wa/leads/${appState.selectedLead.id}/send`,{
method:"POST",
headers:{"Content-Type":"application/json"},
body:JSON.stringify({message:text})
});

input.value="";
fetchMessages(appState.selectedLead.id);
}

/* FILTER */
function setFilter(f){
appState.filter=f;
document.querySelectorAll(".filter").forEach(x=>x.classList.remove("active"));
event.target.classList.add("active");
renderLeads();
}

/* RENDER LEADS */
function renderLeads(){
const list=document.getElementById("leadList");
list.innerHTML="";

let leads=appState.leads;

const search=document.getElementById("searchInput").value.toLowerCase();
if(search){
leads=leads.filter(l=> (l.name||"").toLowerCase().includes(search));
}

if(appState.filter!=="all"){
leads=leads.filter(l=>l.status===appState.filter);
}

if(!leads.length){
list.innerHTML='<div class="empty">No hay leads</div>';
return;
}

leads.forEach(l=>{
const div=document.createElement("div");
div.className="lead-item";
if(appState.selectedLead?.id===l.id)div.classList.add("active");

div.innerHTML=`
<div class="lead-name">${l.name||l.phone}</div>
<div class="lead-last">${l.last_message||""}</div>
${appState.unread[l.id]?`<div class="badge">${appState.unread[l.id]}</div>`:""}
`;

div.onclick=()=>{
appState.selectedLead=l;
fetchMessages(l.id);
renderLeads();
};

list.appendChild(div);
});
}

/* RENDER MESSAGES */
function renderMessages(){
const container=document.getElementById("messages");
container.innerHTML="";

const msgs=appState.messages[appState.selectedLead.id]||[];

if(!msgs.length){
container.innerHTML='<div class="empty">Sin mensajes</div>';
return;
}

msgs.forEach(m=>{
const div=document.createElement("div");
div.className="message "+(m.direction==="out"?"out":"in");
div.innerText=m.text;
container.appendChild(div);
});

container.scrollTop=container.scrollHeight;
}

/* PIPELINE */
function renderPipeline(){
const el=document.getElementById("pipeline");

const stages=["new","contacted","closed"];

el.innerHTML="";

stages.forEach(s=>{
const total=appState.leads.filter(l=>l.status===s)
.reduce((sum,l)=>sum+(l.value||0),0);

const div=document.createElement("div");
div.className="stage";
div.innerHTML=`${s}<span>$${total}</span>`;
el.appendChild(div);
});
}

/* CALENDAR */
function renderCalendar(){
const el=document.getElementById("calendar");
const lead=appState.selectedLead;

if(!lead)return;

el.innerHTML=`
<div class="followup">Próximo seguimiento:</div>
<div>${lead.next_follow_up||"No programado"}</div>
`;
}

/* METRICS */
function updateMetrics(){
document.getElementById("leadsCount").innerText=appState.leads.length;

const revenue=appState.leads.reduce((s,l)=>s+(l.value||0),0);
document.getElementById("revenue").innerText="$"+revenue;

const closed=appState.leads.filter(l=>l.status==="closed").length;
const rate=appState.leads.length?(closed/appState.leads.length*100).toFixed(1):0;
document.getElementById("conversion").innerText=rate+"%";
}

/* LOADING */
function renderLoading(){
document.getElementById("leadList").innerHTML='<div class="loading">Cargando...</div>';
}

/* REALTIME POLLING */
setInterval(async ()=>{
if(!appState.selectedLead)return;

const prevCount=(appState.messages[appState.selectedLead.id]||[]).length;

await fetchMessages(appState.selectedLead.id);

const newCount=(appState.messages[appState.selectedLead.id]||[]).length;

if(newCount>prevCount){
appState.unread[appState.selectedLead.id]=(appState.unread[appState.selectedLead.id]||0)+1;
}
},4000);

/* INIT */
fetchLeads();
</script>

</body>
</html>
